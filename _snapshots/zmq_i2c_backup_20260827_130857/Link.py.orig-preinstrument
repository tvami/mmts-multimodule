class xil_i2c(i2c):
    def write(self, offset, byte):
        with SMBus(self._bus) as bus:
            bus.write_byte(self._addr + offset, byte)
        return None

    def read(self, offset):
        with SMBus(self._bus) as bus:
            ret = bus.read_byte(self._addr + offset)
        return ret

