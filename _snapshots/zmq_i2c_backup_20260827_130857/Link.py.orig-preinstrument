MUX_GPIO_MAP: dict[str, mux_gpio_line] = {line.name: line for line in MUX_GPIO}

# TCAL6416 register shadow, keyed by (device address, register). Read-modify-write
# on the mux board expanders needs the current register value; on a bench where
# reads wedge the master (MMTS_GPIO_READBACK=0) we track what we wrote instead of
# reading it back. Seeded from the power-on defaults and kept in step by every
# write that goes through mux_reg_set(), including mux_setup's.
MUX_REG_POR = {0x02: 0xFF, 0x03: 0xFF,   # output port 0 / 1
               0x06: 0xFF, 0x07: 0xFF}   # direction port 0 / 1 (1 = input)
_mux_reg_shadow: dict[tuple[int, int], int] = {}

def mux_reg_set(bus, addr: int, reg: int, val: int):
    """Write one TCAL6416 register and remember the value."""
    bus.write_byte_data(addr, reg, val)
    _mux_reg_shadow[(addr, reg)] = val

def mux_reg_get(bus, addr: int, reg: int) -> int:
    """Current value of one TCAL6416 register.

    Read from the device where that is safe; otherwise return the shadow copy,
    falling back to the power-on default for a register nothing has written yet.
    """
    if MUX_GPIO_READBACK:
        return bus.read_byte_data(addr, reg)
    return _mux_reg_shadow.get((addr, reg), MUX_REG_POR.get(reg, 0xFF))

class mux_gpio(gpio):
    def __init__(self, slot: str, lines: list[mux_gpio_line]):
        self._lines: list[mux_gpio_line] # Type hint
        super().__init__(lines)

        self._slot = slot
        self._i2c_bus_switch = get_i2c_bus_switch(slot)

    def __repr__(self):
        print(f"mux_gpio(slot={repr(slot)}, lines=[")
        for line in lines:
            print(f"  {repr(line)},")
        print("])")

    def write(self, val):
        if not MUX_ROC_GPIO_RESET:
            # Bench where driving S*_RSTB from here wedges the master; the modules
            # were hard-reset during bring-up instead. See MUX_ROC_GPIO_RESET.
            if DEBUG:
                print(f"[MUX] skipping mux_gpio.write({val}) (MMTS_ROC_GPIO_RESET=0)")
            return

        # Retry the whole open->set->close sequence on a transient bus error. On a
        # marginal module the TCAL6416 access intermittently EIOs at a WANDERING point
        # (switch-open one time, an expander read the next) -- the mark of a transient,
        # not a dead device -- and one bare EIO here would otherwise abort startup.
        # Re-open the SMBus fd each attempt so a half-finished sequence starts clean.
        # Mirrors the transient-recovery retry in ROC.__read_I2C_reg/__set_I2C_reg.
        attempts = 5
        for attempt in range(attempts):
            try:
                with SMBus(MUX_MASTER_BUS) as bus:
                    mux_select(bus, self._i2c_bus_switch, 0x20) # GPIO (TCAL6416) sub-bus

                    for line in self._lines:
                        # Write a 0 to the GPIO direction register (0 = output, 1 = input)
                        # without changing the direction of the other GPIOs
                        current_dir = mux_reg_get(bus, line.addr, line._reg_dir)
                        mux_reg_set(bus, line.addr, line._reg_dir,
                                    current_dir & line._bit_inv)

                        # Write a 0 or a 1 to the GPIO without changing the state of the other GPIOs
                        current_out = mux_reg_get(bus, line.addr, line._reg_out)
                        if val:
                            mux_reg_set(bus, line.addr, line._reg_out,
                                        current_out | line._bit_pos)
                        else:
                            mux_reg_set(bus, line.addr, line._reg_out,
                                        current_out & line._bit_inv)

                return
            except OSError as e:
                mux_forget_selection()
                if attempt == attempts - 1:
                    raise
                print(f"IOError in mux_gpio.write (attempt {attempt+1}/{attempts}): {e}. Retrying.")
                sleep(0.1)

    def read(self):
        raise NotImplementedError

def mux_gpio_discover(slot: str) -> dict[str, mux_gpio]:
    gpio_map = {"roc_s0": ["s1_rstb", "s1_i2c_rst"],
                "roc_s1": ["s2_rstb", "s2_i2c_rst"],
                "roc_s2": ["s3_rstb", "s3_i2c_rst"]}
    if not MUX_HAS_I2C_RST_EXPANDER:
        # No TCAL6416 @0x21 on this bench: every ROC.reset() would touch it and
        # wedge the master. Reset over the RSTB lines (0x20) alone.
        gpio_map = {roc: [n for n in names if not n.endswith("_i2c_rst")]
                    for roc, names in gpio_map.items()}
    ret = {}
    for roc, line_names in gpio_map.items():
        ret[roc] = mux_gpio(slot, [line for line in MUX_GPIO if line.name in line_names])
    if ret:
        return ret
    raise Exception("Missing HexaBoard GPIO lines.")

class mux_gpio_lines:
    """
    A set of GPIOs from the same GPIO controller (@ 0x20 or 0x21),
    the same port (0 or 1), and the same purpose, meant to be read
    from and written to at once.
    """
    def __init__(self, lines: list[mux_gpio_line]):
        self.addr = lines[0].addr
        self._reg_dir = lines[0]._reg_dir
        self._reg_out = lines[0]._reg_out
        self._bit_pos = 0
        for line in lines:
            self._bit_pos = self._bit_pos | line._bit_pos
        self._bit_inv = self._bit_pos ^ 0xFF

# ---------------------------------------------------------------------------
# Per-bench configuration. Every write to a device that is not there WEDGES the
# shared write-mostly PL master (Errno 110/5) until the firmware is reloaded, so
# what a bench does NOT have has to be declared rather than discovered.
# Override with environment variables so one checkout serves both benches:
#
#   MMTS_POWER_MGMT_BOARD=1   bench has the power management board  (Alabama/kria4)
#   MMTS_I2C_RST_EXPANDER=0   TCAL6416 @0x21 absent, never write it (Alabama/kria4)
#   MMTS_SLOTS=BC             only these slots' PCA9848 switches answer (Alabama/kria4)
#
# Defaults reproduce the FNAL/kria10 two-module bench: no power management
# board, both GPIO expanders present, all three switches populated.
# ---------------------------------------------------------------------------
def _mux_env_flag(name: str, default: bool) -> bool:
    return os.environ.get(name, "1" if default else "0").strip().lower() \
        in ("1", "true", "yes", "on")

# The MMTS two-module bench has NO power management board -- the hexaboards are powered
# via the per-module TCAL6416 expanders (0x20/0x21) by enableROCs.py. Writing to an absent
# power-mgmt board on the shared master WEDGES the bus (Errno 110/5), so skip that step here.
# Set True (or MMTS_POWER_MGMT_BOARD=1) only on a bench that actually has one.
MUX_HAS_POWER_MGMT_BOARD = _mux_env_flag("MMTS_POWER_MGMT_BOARD", False)

# The second mux board GPIO expander (TCAL6416 @0x21, the S*_I2C_RST lines) is not
# populated on every bench; on the Alabama bench writing to it wedges the master.
MUX_HAS_I2C_RST_EXPANDER = _mux_env_flag("MMTS_I2C_RST_EXPANDER", True)

# Slots whose PCA9848 switch actually answers. mux_setup opens and closes the
# sub-buses of each of these; a switch that is not there NACKs and wedges the bus.
MUX_SLOTS = [s for s in os.environ.get("MMTS_SLOTS", "ABC").strip().upper()
             if s in ("A", "B", "C")] or ["A", "B", "C"]

# Whether the mux board GPIO expanders may be READ. On the Alabama bench a read of
# the TCAL6416 wedges the master partway through the per-ROC resets, so the
# read-modify-write in mux_gpio.write has to run off the register shadow instead
# (MMTS_GPIO_READBACK=0). See mux_reg_get/mux_reg_set below.
MUX_GPIO_READBACK = _mux_env_flag("MMTS_GPIO_READBACK", True)

# Whether ROC.reset() may drive the mux board S*_RSTB lines. zmq_server builds the
# board twice (once to identify the ROC type, once for real) and resets every ROC
# each time; on the Alabama bench that repeated toggling wedges the master even on
# a plain write. The modules there are hard-reset by enableROCs_alabama.py's RSTB
# release immediately before the server starts, so the repeat is redundant and
# MMTS_ROC_GPIO_RESET=0 turns mux_gpio.write into a no-op.
MUX_ROC_GPIO_RESET = _mux_env_flag("MMTS_ROC_GPIO_RESET", True)

# Power management board ADDR0, ADDR1, ADDR2 jumpers (False = no jumper, True = jumper)
POWER_MGMT_BOARD_ADDR_JUMPERS = {2: False, 1: False, 0: False}
POWER_MGMT_BOARD_ADDR = sum([has_jumper << bit for bit, has_jumper in POWER_MGMT_BOARD_ADDR_JUMPERS.items()])
#                         ---   --0   -1-   -10   2--   2-0   21-   210
POWER_MGMT_BOARD_GPIO = (0x27, 0x26, 0x25, 0x24, 0x23, 0x22, 0x21, 0x20)[POWER_MGMT_BOARD_ADDR]
POWER_MGMT_BOARD_ADC  = (0x76, 0x74, 0x64, 0x56, 0x34, 0x26, 0x16, 0x14)[POWER_MGMT_BOARD_ADDR]

def mux_setup(slot: str):
    """
    Power the hexaboard, its HGCROCs, and make sure the latter are out of their reset state:
    - Enable hexaboard power from the power management board (if any),
    - Enable the hexaboard's LDO regulators to power the HGCROCs,
    - Set the soft and hard HGCROCs reset pins to a HIGH state.

    Args:
        slot (str): Module multiplexer board slot ("A", "B", or "C")
    """
    PWR_EN = mux_gpio_lines([
        MUX_GPIO_MAP["s1_pwr_en"],
        MUX_GPIO_MAP["s2_pwr_en"],
        MUX_GPIO_MAP["s3_pwr_en"],
    ])
    RSTB = mux_gpio_lines([
        MUX_GPIO_MAP["s1_rstb"],
        MUX_GPIO_MAP["s2_rstb"],
        MUX_GPIO_MAP["s3_rstb"],
    ])
    I2C_RST = mux_gpio_lines([
        MUX_GPIO_MAP["s1_i2c_rst"],
        MUX_GPIO_MAP["s2_i2c_rst"],
        MUX_GPIO_MAP["s3_i2c_rst"],
    ])

    if DEBUG:
        print(f"[MUX] Power management board ADDR jumpers: {POWER_MGMT_BOARD_ADDR_JUMPERS}")
        print(f"[MUX] Power management board GPIO address: {POWER_MGMT_BOARD_GPIO:#04x}")

    # This function drives the PCA9848s directly, so any cached selection from
    # earlier accesses no longer describes the hardware.
    mux_forget_selection()

    with SMBus(MUX_MASTER_BUS) as bus:
        ##############################
        ### Power management board ###
        # Skipped on the MMTS bench (no power management board). Connecting the "Spare"
        # sub-bus and writing to an absent board wedges the shared master (Errno 110/5),
        # which then kills the switch write below. See MUX_HAS_POWER_MGMT_BOARD above.
        if MUX_HAS_POWER_MGMT_BOARD:
            # Connect the hexacontroller to the power management board
            for s in MUX_SLOTS:
                bus.write_byte(get_i2c_bus_switch(s), 0x10) # "Spare" sub-bus (power management board)

            i2cdetect("Power management board")
            mask = {"A": 0b001, "B": 0b010, "C": 0b100}[slot]
            try:
                # TCA9535 @ 0x26, P00 'EN_M1' output direction
                # TCA9535 @ 0x26, P01 'EN_M2' output direction
                # TCA9535 @ 0x26, P02 'EN_M3' output direction
                bus.write_byte_data(POWER_MGMT_BOARD_GPIO, 0x06, 0xF8) # 0b11111000 port 0 direction
                # TCA9535 @ 0x26, P00 'EN_M1' HIGH state
                # TCA9535 @ 0x26, P01 'EN_M2' HIGH state
                # TCA9535 @ 0x26, P02 'EN_M3' HIGH state
                bus.write_byte_data(POWER_MGMT_BOARD_GPIO, 0x02, mask) # 0b00000??? port 0 output (??? = 001, 010, or 100)
            except Exception as e:
                print(e)
                pass # No power management board is used, or there is an I2C error

        ### Power management board ###
        ##############################

        # Connect the hexacontroller to the mux board TCAL6416 GPIO controllers for this slot
        for s in MUX_SLOTS:
            bus.write_byte(get_i2c_bus_switch(s), 0x00) # No sub-bus
        for s in MUX_SLOTS:
            bus.write_byte(get_i2c_bus_switch(s), 0x20) # "Sgl" sub-bus (TCAL6416 GPIO controllers)

        #########################
        ### Multiplexer board ###

        # TCAL6416 @ 0x20, P1x (port 1)

        # TCAL6416 @ 0x20, P12 'S1_PWR_EN' output direction
        # TCAL6416 @ 0x20, P13 'S2_PWR_EN' output direction
        # TCAL6416 @ 0x20, P14 'S3_PWR_EN' output direction
        mux_reg_set(bus, PWR_EN.addr, PWR_EN._reg_dir, PWR_EN._bit_inv)
      # bus.write_byte_data(0x20,        0x07,            0xE3) # 0b11100011 port 1 dir

        # TCAL6416 @ 0x20, P12 'S1_PWR_EN' HIGH state
        # TCAL6416 @ 0x20, P13 'S2_PWR_EN' HIGH state
        # TCAL6416 @ 0x20, P14 'S3_PWR_EN' HIGH state
        mux_reg_set(bus, PWR_EN.addr, PWR_EN._reg_out, PWR_EN._bit_pos)
      # bus.write_byte_data(0x20,        0x03,            0x1C) # 0b00011100 port 1 out

        # TCAL6416 @ 0x20, P0x (port 0)

        # TCAL6416 @ 0x20, P01 'S1_RSTB' output direction
        # TCAL6416 @ 0x20, P02 'S2_RSTB' output direction
        # TCAL6416 @ 0x20, P03 'S3_RSTB' output direction
        mux_reg_set(bus, RSTB.addr, RSTB._reg_dir, RSTB._bit_inv)
      # bus.write_byte_data(0x20,      0x06,          0xF1) # 0b11110001 port 0 dir

        # TCAL6416 @ 0x20, P01 'S1_RSTB' HIGH state
        # TCAL6416 @ 0x20, P02 'S2_RSTB' HIGH state
        # TCAL6416 @ 0x20, P03 'S3_RSTB' HIGH state
        mux_reg_set(bus, RSTB.addr, RSTB._reg_out, RSTB._bit_pos)
      # bus.write_byte_data(0x20,      0x02,          0x0E) # 0b00001110 port 0 out

        # TCAL6416 @ 0x21, P0x (port 0)
        # Skipped where 0x21 is not populated (MMTS_I2C_RST_EXPANDER=0): the write
        # NACKs and wedges the master for every later access. The HGCROCs come out
        # of I2C reset anyway -- the line is pulled up on those boards.
        if MUX_HAS_I2C_RST_EXPANDER:
            # TCAL6416 @ 0x21, P04 'S1_I2C_RST' output direction
            # TCAL6416 @ 0x21, P05 'S2_I2C_RST' output direction
            # TCAL6416 @ 0x21, P06 'S3_I2C_RST' output direction
            mux_reg_set(bus, I2C_RST.addr, I2C_RST._reg_dir, I2C_RST._bit_inv)
          # bus.write_byte_data(0x21,         0x06,             0x8f) # 0b10001111 port 0 dir

            # TCAL6416 @ 0x21, P04 'S1_I2C_RST' HIGH state
            # TCAL6416 @ 0x21, P05 'S2_I2C_RST' HIGH state
            # TCAL6416 @ 0x21, P06 'S3_I2C_RST' HIGH state
            mux_reg_set(bus, I2C_RST.addr, I2C_RST._reg_dir, I2C_RST._bit_pos)
          # bus.write_byte_data(0x21,         0x02,             0x70) # 0b01110000 port 0 out

        ### Multiplexer board ###
        #########################

        # Disconnect the hexacontroller from all multiplexer board sub-buses
        for s in MUX_SLOTS:
            bus.write_byte(get_i2c_bus_switch(s), 0)
    mux_forget_selection()
